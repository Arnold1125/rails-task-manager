<div class="container" >
  <h1>My Tasks</h1>
    <% @tasks.each do |task| %>
      <p>
      <%= link_to task.title, task_path(task) %>
      <% if task.completed %>
        <i class="fa-solid fa-check"></i>
      <% else %>
        <i class="fa-solid fa-xmark"></i>
      <% end %>
      </p>

    <%end%>
</div>

